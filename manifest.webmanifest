{
  "name": "DeliveryBuddy MK2",
  "short_name": "DeliveryBuddy",
  "description": "Decide if a delivery offer is worth it, then track real earnings, expenses and taxes across Uber, DoorDash and Grubhub.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0c0c0f",
  "theme_color": "#0c0c0f",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "image", "accept": ["image/*"] }
      ]
    }
  }
}
